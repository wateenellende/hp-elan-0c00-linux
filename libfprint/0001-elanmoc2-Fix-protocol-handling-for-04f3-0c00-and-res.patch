+  unsigned int enroll_slot;
+  unsigned int enroll_slot_tries;
+  unsigned int reenroll_slot;
+  GBytes      *reenroll_user_id;
   int      enroll_stage;
   FpPrint *enroll_print;
 };
@@ -85,6 +89,9 @@ elanmoc2_cmd_usb_callback (FpiUsbTransfer *transfer,
 
   if (error)
     {
+      /* A failed or cancelled send must not leave a command marked as in
+       * flight, or the next command would trip the assertion below. */
+      self->in_flight_cmd = NULL;
       fpi_ssm_mark_failed (g_steal_pointer (&self->ssm),
                            g_steal_pointer (&error));
       return;
@@ -109,8 +116,12 @@ elanmoc2_cmd_usb_callback (FpiUsbTransfer *transfer,
       fpi_usb_transfer_fill_bulk (transfer_in, cmd->ep_in,
                                   cmd->in_len);
 
+      /* Cancellable commands wait for a finger: there is no deadline, the
+       * wait ends when the user touches the sensor or the action is
+       * cancelled. */
       fpi_usb_transfer_submit (transfer_in,
-                               ELANMOC2_USB_RECV_TIMEOUT,
+                               cmd->is_cancellable ?
+                               0 : ELANMOC2_USB_RECV_TIMEOUT,
                                cmd->is_cancellable ?
                                fpi_device_get_cancellable (device) : NULL,
                                elanmoc2_cmd_usb_callback,
@@ -238,7 +249,8 @@ elanmoc2_get_user_id_string (FpiDeviceElanMoC2 *self,
   guint max_len = MIN (elanmoc2_get_user_id_max_length (self),
                        g_bytes_get_size (finger_info_response) - offset);
 
-  g_byte_array_set_size (user_id, max_len);
+  /* One extra byte for the terminator, which is not part of the user ID */
