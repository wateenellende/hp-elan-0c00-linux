+/* The sensor deletes a print only when both the number it was committed under
+ * and its user ID match (verified on 04f3:0c00, firmware 2.81); unlike finger
+ * info, this works without identifying a finger first. Both values are kept
+ * in the print's data at enroll time. */
+static void
+elanmoc2_delete_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceElanMoC2 *self = FPI_DEVICE_ELANMOC2 (device);
+
+  g_autoptr(GBytes) buffer_in = g_steal_pointer (&self->buffer_in);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case DELETE_DELETE: {
+        FpPrint *print = NULL;
+        g_autoptr(GVariant) fpi_data = NULL;
+        g_autoptr(GVariant) user_id_v = NULL;
+        guint8 finger_id = 0;
+        gsize user_id_len = 0;
+
+        fpi_device_get_delete_data (device, &print);
+        g_object_get (print, "fpi-data", &fpi_data, NULL);
+
+        if (fpi_data == NULL ||
+            !g_variant_check_format_string (fpi_data, "(y@ay)", FALSE))
+          {
+            fpi_device_delete_complete (device,
+                                        fpi_device_error_new (
+                                          FP_DEVICE_ERROR_DATA_INVALID));
+            fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+            break;
+          }
+
+        g_variant_get (fpi_data, "(y@ay)", &finger_id, &user_id_v);
+        const guint8 *user_id =
+          g_variant_get_fixed_array (user_id_v, &user_id_len, sizeof (guint8));
+
+        g_autoptr(GByteArray) buffer_out =
+          elanmoc2_prepare_cmd (self, &cmd_delete);
+        if (buffer_out == NULL)
+          {
+            fpi_ssm_next_state (ssm);
+            break;
+          }
+        buffer_out->data[3] = 0xf0 | (finger_id + 5);
+        memcpy (&buffer_out->data[4], user_id,
+                MIN (cmd_delete.out_len - 4, user_id_len));
+        fp_info ("Deleting finger %d", finger_id);
+        elanmoc2_cmd_transceive (device, &cmd_delete, buffer_out);
+        break;
+      }
+
+    case DELETE_CHECK_DELETED: {
+        g_assert_nonnull (buffer_in);
+        g_assert (g_bytes_get_size (buffer_in) >= 2);
+        const guint8 *data_in = g_bytes_get_data (buffer_in, NULL);
+
+        if (data_in[1] == 0)
+          {
+            fp_info ("Finger deleted");
+            fpi_device_delete_complete (device, NULL);
+          }
+        else if (data_in[1] == ELANMOC2_RESP_DELETE_NO_SUCH_PRINT)
+          {
+            /* Nothing on the sensor matches, so there is nothing left to
+             * delete */
+            fp_info ("Finger was not on the sensor");
+            fpi_device_delete_complete (device, NULL);
+          }
+        else
+          {
+            fp_info ("Delete failed with error code 0x%02x", data_in[1]);
+            fpi_device_delete_complete (device,
+                                        fpi_device_error_new_msg (
+                                          FP_DEVICE_ERROR_GENERAL,
+                                          "Sensor refused to delete the "
+                                          "fingerprint"));
+          }
+        fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+        break;
+      }
+    }
+}
+
+static void
+elanmoc2_delete (FpDevice *device)
+{
+  FpiDeviceElanMoC2 *self = FPI_DEVICE_ELANMOC2 (device);
+
+  fp_info ("[elanmoc2] New delete operation");
+  self->ssm = fpi_ssm_new (device, elanmoc2_delete_run_state,
+                           DELETE_NUM_STATES);
+  fpi_ssm_start (self->ssm, elanmoc2_ssm_completed_callback);
+}
