 }
 
+/* Whether a finger info reply actually carries a user ID */
+static gboolean
+elanmoc2_finger_info_is_valid (FpiDeviceElanMoC2 *self,
+                               GBytes            *finger_info_response)
+{
+  gsize size = 0;
+  const guint8 *data = g_bytes_get_data (finger_info_response, &size);
+  guint offset = self->dev_type == ELANMOC2_DEV_0C5E ? 3 : 2;
+
+  return size > offset && data[1] != ELANMOC2_RESP_FINGER_INFO_LOCKED;
+}
+
 static FpPrint *
 elanmoc2_print_new_from_finger_info (FpiDeviceElanMoC2 *self,
                                      guint8             finger_id,
@@ -256,7 +280,8 @@ elanmoc2_print_new_from_finger_info (FpiDeviceElanMoC2 *self,
 {
   g_autoptr(GBytes) user_id = elanmoc2_get_user_id_string (self,
                                                            finger_info_resp);
-  guint8 user_id_len = g_bytes_get_size (user_id);
+  /* Exclude the terminator added by elanmoc2_get_user_id_string() */
+  guint8 user_id_len = g_bytes_get_size (user_id) - 1;
   const char *user_id_data = g_bytes_get_data (user_id, NULL);
 
   if (g_str_has_prefix ( user_id_data, "FP"))
@@ -290,15 +315,50 @@ elanmoc2_print_new_from_finger_info (FpiDeviceElanMoC2 *self,
   return g_steal_pointer (&print);
 }
 
-static void
-elanmoc2_cancel (FpDevice *device)
+/* The sensor never replies to the abort command (verified on 04f3:0c00,
+ * firmware 2.81), so it is sent on its own, outside the command state machine:
+ * waiting for a reply would leave a read pending on the command endpoint that
+ * swallows the response to whatever command comes next. */
+static FpiUsbTransfer *
+elanmoc2_abort_transfer_new (FpDevice *device)
 {
   FpiDeviceElanMoC2 *self = FPI_DEVICE_ELANMOC2 (device);
 
+  g_autoptr(GByteArray) buffer_out = elanmoc2_prepare_cmd (self, &cmd_abort);
+  FpiUsbTransfer *transfer = fpi_usb_transfer_new (device);
+
+  transfer->short_is_error = TRUE;
+  fpi_usb_transfer_fill_bulk_full (transfer,
+                                   ELANMOC2_EP_CMD_OUT,
+                                   g_byte_array_steal (buffer_out, NULL),
+                                   cmd_abort.out_len,
+                                   g_free);
+  return transfer;
+}
+
+static void
+elanmoc2_abort_callback (FpiUsbTransfer *transfer,
+                         FpDevice       *device,
+                         gpointer        user_data,
+                         GError         *error)
+{
+  if (error)
+    {
+      fp_info ("Failed to send abort command: %s", error->message);
+      g_error_free (error);
+    }
+}
+
+static void
+elanmoc2_cancel (FpDevice *device)
+{
   fp_info ("Cancelling any ongoing requests");
 
-  g_autoptr(GByteArray) buffer_out = elanmoc2_prepare_cmd (self, &cmd_abort);
-  elanmoc2_cmd_transceive (device, &cmd_abort, buffer_out);
+  fpi_usb_transfer_submit (elanmoc2_abort_transfer_new (device),
+                           ELANMOC2_USB_SEND_TIMEOUT,
+                           NULL,
+                           elanmoc2_abort_callback,
+                           NULL);
 }
 
 static void
@@ -325,7 +385,17 @@ elanmoc2_close (FpDevice *device)
   g_autoptr(GError) error = NULL;
 
   fp_info ("Closing device");
-  elanmoc2_cancel (device);
+
+  /* Sent synchronously so that it is on the wire before the interface is
+   * released */
+  g_autoptr(FpiUsbTransfer) transfer = elanmoc2_abort_transfer_new (device);
+  if (!fpi_usb_transfer_submit_sync (transfer, ELANMOC2_USB_SEND_TIMEOUT,
+                                     &error))
+    {
+      fp_info ("Failed to send abort command: %s", error->message);
+      g_clear_error (&error);
+    }
+
   g_usb_device_release_interface (fpi_device_get_usb_device (FP_DEVICE (device)),
                                   0, 0, &error);
   fpi_device_close_complete (device, g_steal_pointer (&error));
@@ -451,6 +521,32 @@ elanmoc2_get_finger_error (GBytes *buffer_in, gboolean *out_can_retry)
     }
 }
 
+/* Whether two prints refer to the same on-sensor print. Only the user ID is
+ * compared: the number stored alongside it is the one the print was committed
+ * under for an enrolled print, but the one reported by the sensor for an
+ * identified print, and those can differ (see ENROLL_ATTEMPT_DELETE). */
+static gboolean
+elanmoc2_print_same_user_id (FpPrint *a, FpPrint *b)
+{
+  g_autoptr(GVariant) data_a = NULL;
+  g_autoptr(GVariant) data_b = NULL;
+  g_autoptr(GVariant) user_id_a = NULL;
+  g_autoptr(GVariant) user_id_b = NULL;
+
+  g_object_get (a, "fpi-data", &data_a, NULL);
+  g_object_get (b, "fpi-data", &data_b, NULL);
+
+  if (data_a == NULL || data_b == NULL ||
+      !g_variant_check_format_string (data_a, "(y@ay)", FALSE) ||
+      !g_variant_check_format_string (data_b, "(y@ay)", FALSE))
+    return FALSE;
+
+  g_variant_get (data_a, "(y@ay)", NULL, &user_id_a);
+  g_variant_get (data_b, "(y@ay)", NULL, &user_id_b);
+
+  return g_variant_equal (user_id_a, user_id_b);
+}
+
 static void
 elanmoc2_identify_verify_complete (FpDevice *device, GError *error)
 {
@@ -488,7 +584,7 @@ elanmoc2_identify_verify_report (FpDevice *device, FpPrint *print,
           for (int i = 0; i < gallery->len; i++)
             {
               FpPrint *to_match = g_ptr_array_index (gallery, i);
-              if (fp_print_equal (to_match, print))
+              if (elanmoc2_print_same_user_id (to_match, print))
                 {
                   fp_info ("Identify: finger matches");
                   fpi_device_identify_report (device,
@@ -500,19 +596,21 @@ elanmoc2_identify_verify_report (FpDevice *device, FpPrint *print,
             }
           fp_info ("Identify: no match");
         }
-      fpi_device_identify_report (device, NULL, print, *error);
+      fpi_device_identify_report (device, NULL, print,
+                                  g_steal_pointer (error));
       return TRUE;
     }
   else
     {
-      FpiMatchResult result = FPI_MATCH_FAIL;
+      /* A retry is neither a match nor a mismatch */
+      FpiMatchResult result = *error != NULL ? FPI_MATCH_ERROR : FPI_MATCH_FAIL;
       if (print != NULL)
         {
           FpPrint *to_match = NULL;
           fpi_device_get_verify_data (device, &to_match);
           g_assert_nonnull (to_match);
 
-          if (fp_print_equal (to_match, print))
+          if (elanmoc2_print_same_user_id (to_match, print))
             {
               fp_info ("Verify: finger matches");
               result = FPI_MATCH_SUCCESS;
@@ -520,10 +618,10 @@ elanmoc2_identify_verify_report (FpDevice *device, FpPrint *print,
           else
             {
               fp_info ("Verify: finger does not match");
-              print = NULL;
             }
         }
-      fpi_device_verify_report (device, result, print, *error);
+      fpi_device_verify_report (device, result, print,
+                                g_steal_pointer (error));
       return result != FPI_MATCH_FAIL;
     }
 }
@@ -599,6 +697,21 @@ elanmoc2_identify_run_state (FpiSsm *ssm, FpDevice *device)
     case IDENTIFY_GET_FINGER_INFO: {
         g_assert_nonnull (buffer_in);
         fpi_device_report_finger_status (device, FP_FINGER_STATUS_PRESENT);
+
+        g_assert (data_in_len >= 2);
+        if (data_in[1] == ELANMOC2_RESP_NOT_ENROLLED)
+          {
+            /* An unknown finger is an ordinary "no match", not a device
+             * error: reporting it as missing data would tell the caller that
+             * the print it asked about is gone from the sensor. */
+            fp_info ("Finger not recognized by the sensor");
+            fpi_device_report_finger_status (device, FP_FINGER_STATUS_NONE);
+            elanmoc2_identify_verify_report (device, NULL, &error);
+            elanmoc2_identify_verify_complete (device, NULL);
+            fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+            break;
+          }
+
         gboolean can_retry = FALSE;
         error = elanmoc2_get_finger_error (buffer_in, &can_retry);
         if (error != NULL)
@@ -606,8 +719,12 @@ elanmoc2_identify_run_state (FpiSsm *ssm, FpDevice *device)
             fp_info ("Identify failed: %s", error->message);
             if (can_retry)
               {
+                /* A result may be reported only once per action, so finish
+                 * here and let the caller start the next attempt. */
+                fpi_device_report_finger_status (device, FP_FINGER_STATUS_NONE);
                 elanmoc2_identify_verify_report (device, NULL, &error);
-                fpi_ssm_jump_to_state (ssm, IDENTIFY_IDENTIFY);
+                elanmoc2_identify_verify_complete (device, NULL);
+                fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
               }
             else
               {
@@ -636,7 +753,8 @@ elanmoc2_identify_run_state (FpiSsm *ssm, FpDevice *device)
           }
         g_assert (buffer_out->len >= 4);
         buffer_out->data[3] = self->print_index;
-        elanmoc2_cmd_transceive (device, &cmd_finger_info, buffer_out);
+        elanmoc2_cmd_transceive_full (device, &cmd_finger_info, buffer_out,
+                                      FALSE);
         break;
       }
 
@@ -644,6 +762,17 @@ elanmoc2_identify_run_state (FpiSsm *ssm, FpDevice *device)
         fpi_device_report_finger_status (device, FP_FINGER_STATUS_NONE);
 
         g_assert_nonnull (buffer_in);
+        if (!elanmoc2_finger_info_is_valid (self, buffer_in))
+          {
+            error = fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                              "Sensor did not return the "
+                                              "identified finger's info");
+            elanmoc2_identify_verify_complete (device,
+                                               g_steal_pointer (&error));
+            fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+            break;
+          }
+
         g_autoptr(FpPrint) print =
           elanmoc2_print_new_from_finger_info (self,
                                                self->print_index,
@@ -684,6 +813,7 @@ elanmoc2_enroll_ssm_completed_callback (FpiSsm *ssm, FpDevice *device,
   /* Pointer is either stolen by fpi_device_enroll_complete() or otherwise
    * unref'd by libfprint elsewhere not in this driver. */
   self->enroll_print = NULL;
+  g_clear_pointer (&self->reenroll_user_id, g_bytes_unref);
   elanmoc2_ssm_completed_callback (ssm, device, error);
 }
 
@@ -731,6 +861,11 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
         g_assert (data_in_len >= 2);
         self->enrolled_num = data_in[1];
 
+        /* The number the new print is enrolled and committed under;
+         * ENROLL_CHECK_ENROLLED moves on if the sensor refuses it */
+        self->enroll_slot = self->enrolled_num % ELANMOC2_MAX_PRINTS;
+        self->enroll_slot_tries = 0;
+
         if (self->enrolled_num >= ELANMOC2_MAX_PRINTS)
           {
             fp_info ("Can't enroll, sensor storage is full");
@@ -820,18 +955,64 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
           }
         g_assert (buffer_out->len >= 4);
         buffer_out->data[3] = self->print_index;
-        elanmoc2_cmd_transceive (device, &cmd_finger_info, buffer_out);
+        elanmoc2_cmd_transceive_full (device, &cmd_finger_info, buffer_out,
+                                      FALSE);
         break;
       }
 
     case ENROLL_ATTEMPT_DELETE: {
         fpi_device_report_finger_status (device, FP_FINGER_STATUS_NONE);
-        fp_info ("Deleting enrolled finger %d", self->print_index);
-        g_assert_nonnull (buffer_in);
 
-        /* Attempt to delete the finger */
-        g_autoptr(GBytes) user_id =
-          elanmoc2_get_user_id_string (self, buffer_in);
+        /* First pass: the finger info for the identified finger just came
+         * in. Later passes come from ENROLL_CHECK_DELETED with no data. */
+        if (buffer_in != NULL)
+          {
+            if (!elanmoc2_finger_info_is_valid (self, buffer_in))
+              {
+                error = fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                  "Sensor did not return the "
+                                                  "enrolled finger's info");
+                fpi_device_enroll_complete (device, NULL,
+                                            g_steal_pointer (&error));
+                fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+                break;
+              }
+
+            g_clear_pointer (&self->reenroll_user_id, g_bytes_unref);
+            self->reenroll_user_id =
+              elanmoc2_get_user_id_string (self, buffer_in);
+            self->reenroll_slot = 0;
+
+            /* Only replace prints libfprint stored itself: one enrolled by
+             * another system (e.g. Windows Hello, which stores a binary SID)
+             * is not ours to delete behind the user's back. */
+            if (!g_str_has_prefix (g_bytes_get_data (self->reenroll_user_id,
+                                                     NULL),
+                                   ELANMOC2_LIBFPRINT_USER_ID_PREFIX))
+              {
+                fp_info ("Finger was enrolled by another system, not deleting");
+                error =
+                  fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_DUPLICATE,
+                                            "This finger is already enrolled "
+                                            "on the sensor by another "
+                                            "operating system; use another "
+                                            "finger or clear the sensor "
+                                            "storage first");
+                fpi_device_enroll_complete (device, NULL,
+                                            g_steal_pointer (&error));
+                fpi_ssm_mark_completed (g_steal_pointer (&self->ssm));
+                break;
+              }
+          }
+
+        g_assert_nonnull (self->reenroll_user_id);
+
+        /* The number the sensor reports when it identifies a finger is not
+         * always the number the print was committed under, which is the one
+         * deleting needs: a print committed as 1 on an otherwise empty
+         * sensor is identified as 0 and can only be deleted as 1 (observed
+         * on 04f3:0c00, firmware 2.81). A wrong number is refused without
+         * side effects, so try each. */
