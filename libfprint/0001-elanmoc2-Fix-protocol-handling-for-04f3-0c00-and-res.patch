+        buffer_out->data[3] = 0xf0 | (self->reenroll_slot + 5);
         memcpy (&buffer_out->data[4],
-                g_bytes_get_data (user_id, NULL),
+                g_bytes_get_data (self->reenroll_user_id, NULL),
                 user_id_bytes);
+        fp_info ("Trying to delete the enrolled finger from slot %d",
+                 self->reenroll_slot);
         elanmoc2_cmd_transceive (device, &cmd_delete, buffer_out);
 
         break;
@@ -855,38 +1038,34 @@ elanmoc2_enroll_run_state (FpiSsm *ssm, FpDevice *device)
         g_assert_nonnull (data_in);
         g_assert (g_bytes_get_size (buffer_in) >= 2);
 
-        if (data_in[1] != 0)
-          {
-            fp_info ("Failed to delete finger %d, wiping sensor",
